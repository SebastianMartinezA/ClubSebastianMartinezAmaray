# Copiar a .env y completar. NUNCA versionar el .env con valores reales.

# --- Base de datos (PostgreSQL) ---------------------------------------------
# Render entrega la URL como postgres://: el backend la normaliza sola.
DATABASE_URL=postgresql+psycopg2://usuario:password@localhost:5432/club
# Crea el esquema al arrancar (create_all). En producción se deja en true para este TP.
AUTO_CREATE_TABLES=true
# Carga sedes, espacios y usuario demo al arrancar (idempotente).
SEED_ON_STARTUP=true

# --- Aplicación --------------------------------------------------------------
ENVIRONMENT=development
# Con DEBUG=true, POST /auth/forgot-password devuelve el token en la respuesta
# (solo sirve si NO hay SMTP configurado). Tiene que ser false en producción.
DEBUG=false

# --- JWT propio --------------------------------------------------------------
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

# --- Autenticación alternativa (opcional, desactivada por defecto) -----------
# local = JWT propio (recomendado). firebase = valida ID tokens de Firebase Auth por JWKS.
AUTH_PROVIDER=local
FIREBASE_PROJECT_ID=
# Opcional: override del endpoint JWKS de Google.
FIREBASE_JWKS_URL=

# --- Correo de recuperación de contraseña ------------------------------------
# Ojo: el plan gratuito de Render bloquea el tráfico saliente a los puertos SMTP (25/465/587),
# así que desplegado el SMTP no funciona. Para producción, usar la API HTTPS de Resend.
# Si RESEND_API_KEY está cargada, tiene prioridad sobre SMTP.
RESEND_API_KEY=
# Remitente verificado. Sin dominio propio en Resend: onboarding@resend.dev (solo entrega al
# correo de la cuenta). Con dominio verificado: no-reply@tudominio.com
MAIL_FROM=

# SMTP (sirve para correr el backend en local o en un VPS, no en Render free)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# --- Notificaciones push (Firebase Cloud Messaging HTTP v1) ------------------
# JSON de la cuenta de servicio en una sola línea. Vacío = el job solo loguea.
FCM_SERVICE_ACCOUNT_JSON=

# --- Scheduler del job de avisos (corre solo, dentro de la API) --------------
# true = un loop interno corre el job cada N segundos (así el aviso sale sin que nadie lo dispare).
NOTIFICATIONS_SCHEDULER_ENABLED=true
NOTIFICATIONS_SCHEDULER_INTERVAL_SECONDS=60

# --- CORS --------------------------------------------------------------------
# "*" o lista separada por comas: https://app.club.com,http://localhost:3000
CORS_ORIGINS=*
